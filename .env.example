# Copy names into the cloud provider's server-only environment settings.
# This file contains no usable credentials. Never commit a populated .env file.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_APP_URL=https://giftportals.example.invalid
CRON_SECRET=
ENABLE_SIGNUP=false
ENABLE_GENERATION=false
TRIPO_API_KEY=
WORLD_LABS_API_KEY=
# Fictional shared accounts; public demo sessions are READ-ONLY.
DEMO_SENDER_EMAIL=maya@giftportals-demo.invalid
DEMO_SENDER_PASSWORD=
DEMO_RECIPIENT_EMAIL=noah@giftportals-demo.invalid
DEMO_RECIPIENT_PASSWORD=
# Optional public values; anon key is governed by RLS, never the service key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional operator-only cloud verification. Use private fictional QA accounts
# with is_demo=false, not shared public demo credentials. Generation stays off.
RUN_CLOUD_INTEGRATION=false
QA_OWNER_EMAIL=
QA_OWNER_PASSWORD=
QA_RECIPIENT_EMAIL=
QA_RECIPIENT_PASSWORD=
