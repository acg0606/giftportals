{
  "name": "giftportals",
  "version": "11.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4323 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs api/tests/*.test.mjs",
    "typecheck:server": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext --types node api/giftportals.ts api/tick.ts api/instant.ts api/story-audio.ts api/instant-cloud.ts api/instant-cloud-tick.ts api/instant-cloud-retention.ts api/instant-gallery.ts api/place-assistant.ts",
    "setup:audio": "node tools/setup-local-audio.mjs",
    "probe:audio": "node tools/probe-local-audio.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4323 --strictPort",
    "preflight:cloud": "node tools/cloud-preflight.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@sparkjsdev/spark": "2.1.0",
    "@supabase/supabase-js": "2.57.4",
    "cesium": "1.138.0",
    "three": "0.186.0",
    "three-mesh-bvh": "0.9.15"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "6.4.2"
  }
}
